# ============================================================
# .env.example — Plantilla de variables de entorno
# IV Rally Nacional de Innovación — Nicaragua Innova 2026
# ============================================================
# Copia este archivo como .env y completa los valores reales:
#   cp .env.example .env
#
# NUNCA subas .env a Git. Está en .gitignore.
# ============================================================

# --- CREDENCIALES (obligatorias) ---
RALLY_USERNAME=
RALLY_PASSWORD=

# --- EDICIÓN Y SEDE (opcionales, tienen valores por defecto) ---
# RALLY_EDITION_UUID=4f13f9a9-8bfc-44a3-99ac-a578e9908c9b
# RALLY_SEDE_NAME=BICU, Puerto Cabezas

# --- URL BASE (opcional) ---
# RALLY_BASE_URL=https://apprally.nicaraguainnova.gob.ni

# --- HTTP (opcionales) ---
# RALLY_REQUEST_TIMEOUT=30
# RALLY_USER_AGENT=RallyMonitor/1.0 (monitor-academico; contacto@ejemplo.com)

# --- NOTIFICACIONES (FASE 3) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL=
