*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# --- Entorno virtual ---
venv/
.venv/
env/
ENV/
.virtualenv/

# --- Snapshot de datos ---
